{
  "name": "spreadsheet-engine-workspace",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.10.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "pnpm --filter @worksheet-flow/spreadsheet-engine build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/engine/tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "tsdown": "^0.15.4",
    "vitest": "^3.2.4"
  }
}
